{
  "name": "careflow-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm run build:backend && npm run build",
    "test": "npm --prefix backend test",
    "seed:demo": "npm --prefix backend run seed:demo",
    "admin:bootstrap": "npm --prefix backend run admin:bootstrap --"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
